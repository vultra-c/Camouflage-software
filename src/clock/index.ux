<template>
  <!-- 整屏即一块"黑底红色LED表"：四角边框 + 状态栏 + 超大 时:分 + 中号秒 -->
  <div class="screen" @click="handleTap">

    <!-- 四角装饰边框（绝对定位，不占布局空间） -->
    <div class="corner-h c-tl-h"></div>
    <div class="corner-v c-tl-v"></div>
    <div class="corner-h c-tr-h"></div>
    <div class="corner-v c-tr-v"></div>
    <div class="corner-h c-bl-h"></div>
    <div class="corner-v c-bl-v"></div>
    <div class="corner-h c-br-h"></div>
    <div class="corner-v c-br-v"></div>

    <!-- 第一行：分割线 + 日期 | 星期 + 分割线 -->
    <div class="status-bar">
      <div class="line"></div>
      <div class="bar-row">
        <text class="led-text">{{ dateText }}</text>
        <text class="led-text week-gap">{{ weekText }}</text>
      </div>
      <div class="line"></div>
    </div>

    <!-- 第二行：超大 时:分 -->
    <div class="row-hm">
      <!-- 时十位 -->
      <div class="digit-b">
        <div class="seg sba {{ h1a ? 'on' : '' }}"></div>
        <div class="seg sbb {{ h1b ? 'on' : '' }}"></div>
        <div class="seg sbc {{ h1c ? 'on' : '' }}"></div>
        <div class="seg sbd {{ h1d ? 'on' : '' }}"></div>
        <div class="seg sbe {{ h1e ? 'on' : '' }}"></div>
        <div class="seg sbf {{ h1f ? 'on' : '' }}"></div>
        <div class="seg sbg {{ h1g ? 'on' : '' }}"></div>
      </div>
      <!-- 时个位 -->
      <div class="digit-b">
        <div class="seg sba {{ h2a ? 'on' : '' }}"></div>
        <div class="seg sbb {{ h2b ? 'on' : '' }}"></div>
        <div class="seg sbc {{ h2c ? 'on' : '' }}"></div>
        <div class="seg sbd {{ h2d ? 'on' : '' }}"></div>
        <div class="seg sbe {{ h2e ? 'on' : '' }}"></div>
        <div class="seg sbf {{ h2f ? 'on' : '' }}"></div>
        <div class="seg sbg {{ h2g ? 'on' : '' }}"></div>
      </div>
      <!-- 冒号 -->
      <div class="colon-b">
        <div class="dot-b {{ blink ? 'on' : '' }}"></div>
        <div class="dot-b2 {{ blink ? 'on' : '' }}"></div>
      </div>
      <!-- 分十位 -->
      <div class="digit-b">
        <div class="seg sba {{ m1a ? 'on' : '' }}"></div>
        <div class="seg sbb {{ m1b ? 'on' : '' }}"></div>
        <div class="seg sbc {{ m1c ? 'on' : '' }}"></div>
        <div class="seg sbd {{ m1d ? 'on' : '' }}"></div>
        <div class="seg sbe {{ m1e ? 'on' : '' }}"></div>
        <div class="seg sbf {{ m1f ? 'on' : '' }}"></div>
        <div class="seg sbg {{ m1g ? 'on' : '' }}"></div>
      </div>
      <!-- 分个位 -->
      <div class="digit-b">
        <div class="seg sba {{ m2a ? 'on' : '' }}"></div>
        <div class="seg sbb {{ m2b ? 'on' : '' }}"></div>
        <div class="seg sbc {{ m2c ? 'on' : '' }}"></div>
        <div class="seg sbd {{ m2d ? 'on' : '' }}"></div>
        <div class="seg sbe {{ m2e ? 'on' : '' }}"></div>
        <div class="seg sbf {{ m2f ? 'on' : '' }}"></div>
        <div class="seg sbg {{ m2g ? 'on' : '' }}"></div>
      </div>
    </div>

    <!-- 第三行：秒（中号，左侧冒号跟随闪烁） -->
    <div class="row-sec">
      <div class="colon-s">
        <div class="dot-s {{ blink ? 'on' : '' }}"></div>
        <div class="dot-s2 {{ blink ? 'on' : '' }}"></div>
      </div>
      <!-- 秒十位 -->
      <div class="digit-s">
        <div class="seg ssa {{ s1a ? 'on' : '' }}"></div>
        <div class="seg ssb {{ s1b ? 'on' : '' }}"></div>
        <div class="seg ssc {{ s1c ? 'on' : '' }}"></div>
        <div class="seg ssd {{ s1d ? 'on' : '' }}"></div>
        <div class="seg sse {{ s1e ? 'on' : '' }}"></div>
        <div class="seg ssf {{ s1f ? 'on' : '' }}"></div>
        <div class="seg ssg {{ s1g ? 'on' : '' }}"></div>
      </div>
      <!-- 秒个位 -->
      <div class="digit-s">
        <div class="seg ssa {{ s2a ? 'on' : '' }}"></div>
        <div class="seg ssb {{ s2b ? 'on' : '' }}"></div>
        <div class="seg ssc {{ s2c ? 'on' : '' }}"></div>
        <div class="seg ssd {{ s2d ? 'on' : '' }}"></div>
        <div class="seg sse {{ s2e ? 'on' : '' }}"></div>
        <div class="seg ssf {{ s2f ? 'on' : '' }}"></div>
        <div class="seg ssg {{ s2g ? 'on' : '' }}"></div>
      </div>
    </div>

  </div>
</template>

<script>
  import app from '@system.app'

  const WEEKS = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT']
  // 段码掩码：a=64 b=32 c=16 d=8 e=4 f=2 g=1
  const SEG = {
    0: 64 + 32 + 16 + 8 + 4 + 2,
    1: 32 + 16,
    2: 64 + 32 + 1 + 4 + 8,
    3: 64 + 32 + 1 + 16 + 8,
    4: 32 + 2 + 1 + 16,
    5: 64 + 2 + 1 + 16 + 8,
    6: 64 + 2 + 1 + 16 + 8 + 4,
    7: 64 + 32 + 16,
    8: 64 + 32 + 16 + 8 + 4 + 2 + 1,
    9: 64 + 32 + 16 + 8 + 2 + 1
  }
  const EXIT_TAPS = 10
  const EXIT_WINDOW_MS = 6000

  export default {
    data: {
      h1a: false, h1b: false, h1c: false, h1d: false, h1e: false, h1f: false, h1g: false,
      h2a: false, h2b: false, h2c: false, h2d: false, h2e: false, h2f: false, h2g: false,
      m1a: false, m1b: false, m1c: false, m1d: false, m1e: false, m1f: false, m1g: false,
      m2a: false, m2b: false, m2c: false, m2d: false, m2e: false, m2f: false, m2g: false,
      s1a: false, s1b: false, s1c: false, s1d: false, s1e: false, s1f: false, s1g: false,
      s2a: false, s2b: false, s2c: false, s2d: false, s2e: false, s2f: false, s2g: false,
      blink: true,
      dateText: '01-01',
      weekText: 'SUN',
      tapCount: 0
    },

    timer: null,
    exitTimer: null,

    onInit() {
      this.refreshTime()
    },

    onReady() {
      this.startTimer()
    },

    onShow() {
      this.refreshTime()
      this.startTimer()
    },

    onHide() {
      this.stopTimer()
    },

    onDestroy() {
      this.stopTimer()
    },

    startTimer() {
      if (this.timer) {
        return
      }
      this.timer = setInterval(() => {
        this.refreshTime()
      }, 1000)
    },

    stopTimer() {
      if (this.timer) {
        clearInterval(this.timer)
        this.timer = null
      }
    },

    refreshTime() {
      const now = new Date()
      const h = now.getHours()
      const m = now.getMinutes()
      const s = now.getSeconds()

      this.setDigit('h1', Math.floor(h / 10))
      this.setDigit('h2', h % 10)
      this.setDigit('m1', Math.floor(m / 10))
      this.setDigit('m2', m % 10)
      this.setDigit('s1', Math.floor(s / 10))
      this.setDigit('s2', s % 10)
      this.blink = s % 2 === 0

      const mo = now.getMonth() + 1
      const d = now.getDate()
      this.dateText = (mo < 10 ? '0' + mo : '' + mo) + '-' + (d < 10 ? '0' + d : '' + d)
      this.weekText = WEEKS[now.getDay()]
    },

    setDigit(prefix, v) {
      const mask = SEG[v] || 0
      this[prefix + 'a'] = (mask & 64) !== 0
      this[prefix + 'b'] = (mask & 32) !== 0
      this[prefix + 'c'] = (mask & 16) !== 0
      this[prefix + 'd'] = (mask & 8) !== 0
      this[prefix + 'e'] = (mask & 4) !== 0
      this[prefix + 'f'] = (mask & 2) !== 0
      this[prefix + 'g'] = (mask & 1) !== 0
    },

    // 唯一退出方式：6秒内连续点击屏幕10次，应用静默退出
    handleTap() {
      this.tapCount = this.tapCount + 1

      if (this.exitTimer) {
        clearTimeout(this.exitTimer)
      }
      this.exitTimer = setTimeout(() => {
        this.tapCount = 0
        this.exitTimer = null
      }, EXIT_WINDOW_MS)

      if (this.tapCount >= EXIT_TAPS) {
        this.tapCount = 0
        if (this.exitTimer) {
          clearTimeout(this.exitTimer)
          this.exitTimer = null
        }
        this.stopTimer()
        app.terminate()
      }
    },

    // 拦截右滑/返回键：无论怎么滑都退不出去
    onBackPress() {
      return true
    }
  }
</script>

<style>
  .screen {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    background-color: #000000;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* ===== 四角装饰边框 ===== */
  .corner-h {
    position: absolute;
    width: 26px;
    height: 2px;
    background-color: #3c0b07;
  }

  .corner-v {
    position: absolute;
    width: 2px;
    height: 26px;
    background-color: #3c0b07;
  }

  .c-tl-h { left: 20px; top: 24px; }
  .c-tl-v { left: 20px; top: 24px; }
  .c-tr-h { right: 20px; top: 24px; }
  .c-tr-v { right: 20px; top: 24px; }
  .c-bl-h { left: 20px; bottom: 24px; }
  .c-bl-v { left: 20px; bottom: 24px; }
  .c-br-h { right: 20px; bottom: 24px; }
  .c-br-v { right: 20px; bottom: 24px; }

  /* ===== 第一行：状态栏（分割线 + 日期 星期） ===== */
  .status-bar {
    flex-direction: column;
    align-items: center;
  }

  .line {
    width: 264px;
    height: 1px;
    background-color: #340809;
  }

  .bar-row {
    width: 264px;
    margin-top: 9px;
    margin-bottom: 9px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .led-text {
    font-family: monospace;
    font-size: 44px;
    font-weight: bold;
    color: #ff1e00;
  }

  .week-gap {
    margin-left: 28px;
    color: #d41a00;
  }

  /* ===== 第二行：超大 时:分（数字 68x130） ===== */
  .row-hm {
    margin-top: 18px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .digit-b {
    position: relative;
    width: 68px;
    height: 130px;
    margin-left: 3px;
    margin-right: 3px;
  }

  .seg {
    position: absolute;
    border-radius: 3px;
    background-color: #160302;
  }

  /* 大号数字：横段 46x14，竖段 14x40 */
  .sba { left: 11px; top: 0px; width: 46px; height: 14px; }
  .sbg { left: 11px; top: 58px; width: 46px; height: 14px; }
  .sbd { left: 11px; top: 116px; width: 46px; height: 14px; }
  .sbf { left: 0px; top: 16px; width: 14px; height: 40px; }
  .sbb { left: 54px; top: 16px; width: 14px; height: 40px; }
  .sbe { left: 0px; top: 74px; width: 14px; height: 40px; }
  .sbc { left: 54px; top: 74px; width: 14px; height: 40px; }

  .colon-b {
    width: 18px;
    height: 130px;
    margin-left: 3px;
    margin-right: 3px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .dot-b {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background-color: #160302;
  }

  .dot-b2 {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background-color: #160302;
    margin-top: 42px;
  }  /* ===== 第三行：秒（中号 34x66）+ 小冒号 ===== */
  .row-sec {
    margin-top: 20px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .colon-s {
    width: 12px;
    height: 66px;
    margin-right: 12px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .dot-s {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background-color: #160302;
  }

  .dot-s2 {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background-color: #160302;
    margin-top: 32px;
  }

  .digit-s {
    position: relative;
    width: 34px;
    height: 66px;
    margin-left: 3px;
    margin-right: 3px;
  }

  /* 中号数字：横段 22x10，竖段 10x16 */
  .ssa { left: 6px; top: 0px; width: 22px; height: 10px; }
  .ssg { left: 6px; top: 28px; width: 22px; height: 10px; }
  .ssd { left: 6px; top: 56px; width: 22px; height: 10px; }
  .ssf { left: 0px; top: 11px; width: 10px; height: 16px; }
  .ssb { left: 24px; top: 11px; width: 10px; height: 16px; }
  .sse { left: 0px; top: 39px; width: 10px; height: 16px; }
  .ssc { left: 24px; top: 39px; width: 10px; height: 16px; }

  /* 点亮色：Vela样式只支持单类选择器（复合选择器 .a.b 会被编译器丢弃），
     所以用独立的 .on 单类，并置于所有基础类之后以确保覆盖背景色 */
  .on {
    background-color: #ff1e00;
    box-shadow: 0px 0px 10px rgba(255, 45, 0, 0.85);
  }
</style>
